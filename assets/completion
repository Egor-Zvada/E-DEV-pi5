_e_dev_complete() {
 local cur="${COMP_WORDS[COMP_CWORD]}" cmd="${COMP_WORDS[1],,}" sub="${COMP_WORDS[2],,}" words=""
 COMPREPLY=()
 case "$COMP_CWORD" in
  1) words="help settings manuals status links wifi vpn lan speedtest passwd" ;;
  2) case "$cmd" in
      status) words="--once" ;;
      wifi) words="clients status" ;;
      vpn|lan) words="status" ;;
      passwd) words="all" ;;
     esac ;;
  4) if [[ "$cmd:$sub" == vpn:add ]]; then
      mapfile -t COMPREPLY < <(compgen -f -- "$cur")
      compopt -o filenames
      return
     fi ;;
 esac
 mapfile -t COMPREPLY < <(compgen -W "$words" -- "$cur")
}
complete -F _e_dev_complete e-dev E-DEV E-dev edev
