_e_dev_complete() {
 # Reload the installed implementation: open shells follow later code updates.
 local completion_source="${BASH_SOURCE[0]}"
 [[ ! -r "$completion_source" ]] || source "$completion_source"
 _e_dev_complete_impl "$@"
}
_e_dev_complete_impl() {
 local cur="${COMP_WORDS[COMP_CWORD]}" cmd sub item words=""
 cmd=$(printf %s "${COMP_WORDS[1]:-}" | tr '[:upper:]' '[:lower:]')
 sub=$(printf %s "${COMP_WORDS[2]:-}" | tr '[:upper:]' '[:lower:]')
 COMPREPLY=()
 case "$COMP_CWORD" in
  1) words="help settings manuals status links wifi vpn lan speedtest passwd" ;;
  2) case "$cmd" in
      status) words="--once" ;;
      wifi) words="clients status" ;;
      vpn|lan) words="status" ;;
      passwd) words="all" ;;
     esac ;;
  4) if [[ "$cmd:$sub" == vpn:add ]]; then
      while IFS= read -r item; do COMPREPLY+=("$item"); done < <(compgen -f -- "$cur")
      return
     fi ;;
 esac
 while IFS= read -r item; do COMPREPLY+=("$item"); done < <(compgen -W "$words" -- "$cur")
}
complete -o filenames -F _e_dev_complete e-dev E-DEV E-dev edev
