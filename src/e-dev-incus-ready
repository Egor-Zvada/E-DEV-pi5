#!/usr/bin/env python3
"""Keep Incus' readiness deadline, but stop waiting if its daemon has died."""
import pathlib as P
import subprocess as S
import sys
import time


def identity(pid):
    try:
        # PID and start time identify the daemon even if Linux reuses the PID.
        fields = (P.Path('/proc')/str(pid)/'stat').read_text().rsplit(') ', 1)[1].split()
        return None if fields[0] == 'Z' else fields[19]
    except (OSError, IndexError):
        return None


def wait_ready(pid):
    original = identity(pid)
    if original is None:
        return 1
    child = S.Popen(['/usr/libexec/incus/incusd', 'waitready', '--timeout=600'])
    try:
        while child.poll() is None:
            if identity(pid) != original:
                print('Incus daemon exited before becoming ready.', file=sys.stderr)
                return 1
            time.sleep(.5)
        return child.returncode
    finally:
        if child.poll() is None:
            child.terminate()
            try:
                child.wait(timeout=2)
            except S.TimeoutExpired:
                child.kill()
                child.wait()


if __name__ == '__main__':
    sys.exit(wait_ready(int(sys.argv[1])))
