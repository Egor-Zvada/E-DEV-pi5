    while True:
        wifi=load('e-dev-wifi');network=wifi.current()
        mode={'vpn':'VPN ON','direct':'VPN OFF','hybrid':'HYBRID'}.get(text('mode'),'ЗАКРЫТ')
        choice=ui.menu('AP · сеть клиентов',network['address']+' · '+mode+'\nПодсеть, DHCP, DNS и режим трафика общие для всех OUT-портов.',
                       [('wifi','Wi-Fi · название, пароль, канал'),('dhcp','Подсеть и DHCP'),
                        ('dns','DNS · '+', '.join(cfg('hybrid.json',{'dns':['1.1.1.1','8.8.8.8']})['dns'])),
                        ('mode','Режим трафика · '+mode),('hybrid','Hybrid Settings')])
        if choice is None: return
        if choice=='wifi': radio_menu(ui)
        elif choice=='dhcp': lanui.dhcp_menu(ui)
        elif choice=='dns':
            value=ui.input('DNS AP','От одного до трёх публичных DNS IPv4 через пробел:',
                           ' '.join(cfg('hybrid.json',{'dns':['1.1.1.1','8.8.8.8']})['dns']))
