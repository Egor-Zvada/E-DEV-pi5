def lan_menu(ui):
    while True:
        plan=lan.config();state=lan.read(lan.STATE,{})
        choice=ui.menu('LAN · IN','Активный вход: '+lanui.name(plan,state.get('active'),lan.inventory()),
                       [('ports','Входы интернета'),('roles','Основной / резервы / автопереход'),
                        ('check','Проверить входы сейчас'),('status','Состояние LAN')])
        if choice is None: return
        if choice=='ports': lanui.zone_menu(ui,'inputs')
        elif choice=='roles': lanui.roles(ui)
        elif choice=='status': ui.message('LAN',lanui.review(plan))
        elif choice=='check':
            operation(ui,'Проверка входов',['systemctl','start','e-dev-uplink.service'])
            ui.message('LAN',output('/usr/local/sbin/e-dev-lan','status'))


def choose_profile(ui,title,exclude=None,allow_none=False):
    names=sorted(p.stem for p in (B/'profiles').glob('*.conf') if p.stem!=exclude)
    if not names and not allow_none: raise ValueError('Сначала импортируйте VPN-конфигурацию.')
    return ui.menu(title,'Выберите профиль.',[(n,n+(' · активный' if n==text('selected-profile') else '')) for n in names]+([('-','Без резерва')] if allow_none else []))


def vpn_selection(ui):
    mode=ui.menu('Выбор VPN','Общий VPN для AP и контейнеров профиля vpn.',
                 [('default','DEFAULT · основной и резерв'),('manual','MANUAL · только один профиль'),
                  ('auto','AUTO · ежедневный выбор по скорости')])
    if mode is None: return
    if mode=='default':
        primary=choose_profile(ui,'Основной VPN')
        if primary is None: return
        backup=choose_profile(ui,'Резервный VPN',exclude=primary,allow_none=True)
        if backup is None: return
        action(ui,'DEFAULT','vpn','default',primary,backup)
    elif mode=='manual':
        selected=choose_profile(ui,'Единственный VPN')
        if selected is not None: action(ui,'MANUAL','vpn','manual',selected)
    else:
        if not list((B/'profiles').glob('*.conf')): raise ValueError('Сначала импортируйте VPN-конфигурацию.')
        if ui.yes('Включить AUTO?','Каждый профиль измеряется Ookla Speedtest.\nПолный тест расходует сотни MB на профиль.\nДалее ежедневные проверки выполняет сама Pi.'):
            action(ui,'AUTO','vpn','auto')


def vpn_profiles(ui):
    while True:
        policy=cfg('vpn-policy.json');active=text('selected-profile')
        names=sorted(p.stem for p in (B/'profiles').glob('*.conf'))
        choice=ui.menu('VPN · конфигурации','Ключи скрыты. Имена и роли читаются из текущих настроек.',
                       [('add','Импортировать .conf')]+[('profile:'+n,n+(' · активный' if n==active else '')+
                       (' · основной' if n==policy.get('primary') else '')+(' · резерв' if n==policy.get('backup') else '')) for n in names])
        if choice is None: return
        if choice=='add':
            path=ui.file('Импорт AmneziaWG .conf')
            if path is None: continue
            name=ui.input('Имя VPN','Буквы, цифры, дефис, подчёркивание; до 32 символов.',P.Path(path).stem.replace(' ','-')[:32])
            if not name: continue
            if name in names and not ui.yes('Заменить VPN?',name+' уже существует. Активный профиль будет переподключён.'): continue
            action(ui,'Импорт VPN','vpn','add',name,path)
        else:
            choice=choice.removeprefix('profile:')
            selected=ui.menu('VPN · '+choice,'Профиль '+choice,[('replace','Заменить конфигурацию'),('rename','Переименовать'),('remove','Удалить')])
            if selected=='replace':
                path=ui.file('Новый .conf для '+choice)
                if path and ui.yes('Заменить конфигурацию?',choice+'\nАктивный профиль будет переподключён.'):
                    action(ui,'Замена VPN','vpn','add',choice,path)
            elif selected=='rename':
                name=ui.input('Новое имя VPN','Роли основного и резервного сохранятся.',choice)
                if name and name!=choice: action(ui,'Переименование VPN','vpn','rename',choice,name)
            elif selected=='remove' and ui.yes('Удалить VPN?',choice+'\nАктивный, основной и резервный профили сначала нужно освободить.'):
                action(ui,'Удаление VPN','vpn','remove',choice)


def vpn_measurements(ui):
    while True:
        choice=ui.menu('VPN · измерения','Speedtest активного VPN не меняет выбор сервера.',
                       [('active','Измерить активный VPN'),('results','Последние результаты AUTO'),
                        ('repeat','Повторить сравнение AUTO сейчас')])
        if choice is None: return
        if choice=='results': action(ui,'Результаты AUTO','vpn','speeds')
        elif choice=='active': action(ui,'Speedtest','vpn','speedtest')
        elif choice=='repeat':
            if cfg('vpn-policy.json').get('mode')!='auto': raise ValueError('Повторное сравнение доступно в режиме AUTO.')
            if ui.yes('Повторить AUTO?', 'Все профили будут измерены заново. Тест расходует трафик.'):
                action(ui,'Сравнение AUTO','vpn','auto','run')


def vpn_menu(ui):
    while True:
        enabled=text('vpn-enabled','on')=='on'
        choice=ui.menu('VPN',text('selected-profile')+' · '+cfg('vpn-policy.json',{'mode':'manual'})['mode'].upper()+'\nОбщий туннель для AP и VPN-контейнеров.',
                       [('tunnel','Туннель · '+('ВКЛ · awg0' if enabled and P.Path('/sys/class/net/awg0').exists() else 'ВКЛ · нет awg0' if enabled else 'ВЫКЛ')),
                        ('selection','Выбор сервера · DEFAULT / MANUAL / AUTO'),
                        ('profiles','Конфигурации'),('measure','Измерения скорости'),('status','Состояние туннеля')])
        if choice is None: return
        if choice=='tunnel':
            selected=ui.menu('Туннель VPN','VPN OFF в AP меняет маршрут; здесь включается/выключается сам туннель.',
                             [('on','Включить туннель'),('off','Выключить туннель')])
            if selected: action(ui,'Туннель VPN','vpn',selected)
        elif choice=='selection': vpn_selection(ui)
        elif choice=='profiles': vpn_profiles(ui)
        elif choice=='measure': vpn_measurements(ui)
        elif choice=='status': operation(ui,'VPN status',['/usr/local/bin/e-dev','vpn','status'])


def certificates(ui):
    while True:
        rows=json.loads(output('incus','config','trust','list','--format=json'))
        visible=[c for c in rows if c.get('name')!='lxconsole']
        choice=ui.menu('Incus · сертификаты','Публичный .crt добавляется на Pi; приватный .pfx остаётся в браузере.\nСлужебный сертификат LXConsole защищён от удаления.',
                       [('add','Добавить публичный .crt')]+[(c['fingerprint'],str(c.get('name') or 'Без имени')+' · '+c['fingerprint'][:12]) for c in visible])
        if choice is None: return
        if choice=='add':
            path=ui.file('Публичный сертификат .crt')
            if path is None: continue
            name=ui.input('Имя сертификата','Имя браузера / устройства:',P.Path(path).stem)
            if name: action(ui,'Сертификат Incus','cert-add',path,name)
        else:
            cert=next(c for c in visible if c['fingerprint']==choice)
            if ui.yes('Отозвать сертификат?',str(cert.get('name') or 'Без имени')+'\n'+choice+'\nЭтот браузер потеряет доступ к Incus UI.'):
                action(ui,'Сертификат Incus','cert-remove',choice)


def access_menu(ui):
    labels={'ssh':'SSH','ui':'LXConsole','files':'Файлы SMB','incus':'Incus UI · сертификат'}
    while True:
        state=json.loads(output(ACTIONS,'access-state'))
        choice=ui.menu('Доступ и пароли','Пароль Wi-Fi находится в AP → Wi-Fi.\nIncus UI использует сертификаты.',
                       [(n,label+' · '+('ВКЛ' if state[n] else 'ВЫКЛ')) for n,label in labels.items()]+
                       [('password-all','Общий новый пароль · SSH, UI, SMB, AP'),
                        ('all-on','Включить доступ ко всем сервисам'),('all-off','Выключить доступ ко всем сервисам')])
        if choice is None: return
        if choice=='password-all': password(ui,'all')
        elif choice in ('all-on','all-off'):
            enable=choice=='all-on'
            if not ui.yes('Изменить весь доступ?', 'Включить все сервисы?' if enable else 'Выключить SSH, обе панели и SMB?\nПовторный вход по SSH станет недоступен. Включить можно с локальной консоли.\nКонтейнеры и AP продолжат работать.'):
                continue
            action(ui,'Доступ','access','all','on' if enable else 'off')
        else:
            selected=ui.menu(labels[choice],'Доступ '+('включён' if state[choice] else 'выключен'),
                             [('toggle','Выключить доступ' if state[choice] else 'Включить доступ')]+
                             ([('certs','Доверенные сертификаты')] if choice=='incus' else [('password','Сменить пароль')]))
            if selected=='password': password(ui,choice)
            elif selected=='certs': certificates(ui)
            elif selected=='toggle':
                if choice=='ssh' and state[choice] and not ui.yes('Выключить SSH?',
                    'Новые SSH-подключения будут недоступны.\nДля включения используйте монитор и клавиатуру на Pi.'):
                    continue
                action(ui,'Доступ','access',choice,'off' if state[choice] else 'on')


def manuals(ui):
    while True:
        choice=ui.menu('E-DEV · инструкция','Выберите главу. В тексте: стрелки / PgUp / PgDn, / поиск, q — назад.',CHAPTERS)
        if choice is None: return
        path=DOC/(choice+'.txt')
        if not path.exists(): raise ValueError('Глава не установлена. Обновите E-DEV.')
        S.run(['less','-R','--',str(path)])


def root_choices():
    plan=lan.config();state=lan.read(lan.STATE,{})
    active=lanui.name(plan,state.get('active'),lan.inventory())
    ports=max(0,len(plan['outputs'])-1)
    mode={'vpn':'VPN ON','direct':'VPN OFF','hybrid':'HYBRID'}.get(text('mode'),'ЗАКРЫТ')
    return [('lan','LAN / IN · '+active+' · резерв '+('ВКЛ' if plan['failover'] else 'ВЫКЛ')),
            ('out','OUT · дополнительные порты: '+str(ports)),
            ('ap','AP · '+cfg('system.json',{'ssid':'E-DEV'})['ssid']+' · '+mode),
            ('vpn','VPN · '+text('selected-profile')+' · '+cfg('vpn-policy.json',{'mode':'manual'})['mode'].upper()),
            ('status','Статус · живой дашборд'),('access','Доступ и пароли')]


def main():
    if not sys.stdin.isatty() or not sys.stdout.isatty(): raise ValueError('Откройте меню в интерактивном терминале.')
    if not shutil.which('dialog'): raise ValueError('Нужен пакет dialog.')
    ui=tui.Dialog()
    if sys.argv[1:]==['manuals']: return manuals(ui)
    if sys.argv[1:]: raise ValueError('Настройки: e-dev settings')
    if os.geteuid()!=0: raise ValueError('Настройки требуют sudo.')
    if not (B/'lan.json').exists() and not lanui.commit(ui,lan.config()): return
    while True:
        choice=ui.menu('E-DEV 1.0 · Settings',ui.logo(),root_choices())
        if choice is None: return
        try:
            if choice=='lan': lan_menu(ui)
            elif choice=='out': lanui.zone_menu(ui,'outputs')
            elif choice=='ap': ap_menu(ui)
            elif choice=='vpn': vpn_menu(ui)
            elif choice=='status': S.run(['/usr/local/sbin/e-dev-dashboard'])
            elif choice=='access': access_menu(ui)
        except (ValueError,OSError,S.SubprocessError) as error:
            ui.message('Ошибка',str(error))


if __name__=='__main__':
    try: main()
    except (ValueError,OSError,S.SubprocessError) as error:
        print(str(error),file=sys.stderr);sys.exit(1)
    except KeyboardInterrupt: pass
    finally: S.run(['clear'])
