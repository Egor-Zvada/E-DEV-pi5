def load(name):
    path=P.Path('/usr/local/sbin')/name
    if not path.exists(): path=P.Path(__file__).with_name(name)
    loader=importlib.machinery.SourceFileLoader(name.replace('-','_')+'_settings',str(path))
    module=importlib.util.module_from_spec(importlib.util.spec_from_loader(loader.name,loader))
    loader.exec_module(module)
    return module


lanui=load('e-dev-lan-ui')
lan=lanui.lan
tui=load('e-dev-tui')


def cfg(name, default=None):
    path=B/name
    return json.loads(path.read_text()) if path.exists() else default or {}


def text(name, default='—'):
    path=B/name
    return path.read_text().strip() if path.exists() else default


def output(*args):
    r=S.run(args,text=True,capture_output=True,stdin=S.DEVNULL,timeout=30)
    if r.returncode: raise ValueError('Не удалось выполнить '+args[0])
    return r.stdout.strip()


def operation(ui,title,args,payload=None):
    hint='\nИзмерения скорости могут занять несколько минут.' if 'speedtest' in args or 'auto' in args else ''
    ui.run(title,'--infobox','Выполняю…'+hint)
    with tempfile.TemporaryFile(mode='w+t') as log:
        process=S.Popen(args,text=True,stdin=S.PIPE if payload is not None else S.DEVNULL,stdout=log,stderr=S.STDOUT)
        try:
            if payload is not None:
                process.stdin.write(json.dumps(payload));process.stdin.close()
            started=time.monotonic()
            while process.poll() is None:
                if time.monotonic()-started>1200: raise ValueError('Операция превысила время ожидания.')
                log.seek(0);progress=log.read()[-1200:]
                ui.run(title,'--infobox','Выполняю…\n'+progress)
                time.sleep(1)
            log.seek(0);result=log.read()[-3500:]
            if process.returncode: raise ValueError(result or 'Операция не завершилась.')
        finally:
            if process.poll() is None:
                process.terminate()
                try: process.wait(timeout=30)
                except S.TimeoutExpired: process.kill();process.wait()
    ui.message(title,result or 'Готово.')
    return result


def action(ui,title,*args,payload=None):
    return operation(ui,title,[ACTIONS,*args],payload)


def wait_ap(ui):
    ui.run('Применение AP','--infobox','Служба применяет настройки точки…')
    for _ in range(180):
        if not P.Path('/run/e-dev-wifi-request.json').exists():
            result=output('systemctl','show','-p','Result','--value','e-dev-wifi-apply.service')
            if result!='success': raise ValueError('Настройки AP не применены. Служба выполнила откат либо закрыла OUT.\nЖурнал: journalctl -u e-dev-wifi-apply')
            ui.message('AP','Настройки применены.\nТекущие адреса: e-dev links')
            return
        time.sleep(1)
    ui.message('AP','Применение продолжается.\nЖурнал: journalctl -u e-dev-wifi-apply')


def password(ui,service):
    labels={'all':'Общий пароль SSH / LXConsole / файлов / AP','wifi':'Пароль точки доступа',
            'ssh':'Пароль SSH','ui':'Пароль LXConsole','files':'Пароль файлов SMB'}
    prompt='8–63 печатных ASCII-символа. Ввод скрыт.'
    first=ui.password(labels[service],prompt)
    if first is None: return
    second=ui.password(labels[service],'Повторите новый пароль:')
    if second is None: return
    if first!=second: raise ValueError('Пароли не совпадают.')
    if not 8<=len(first)<=63 or any(ord(c)<32 or ord(c)>126 for c in first):
        raise ValueError('Нужно 8–63 печатных ASCII-символа.')
    if service in ('wifi','all') and not ui.yes('Сменить пароль?',
        'Wi-Fi-клиенты потребуется подключить с новым паролем.\nSSH через AP может оборваться.\n'+('Все четыре пароля будут изменены последовательно.' if service=='all' else 'Изменится пароль всех Wi-Fi AP в OUT.')):
        return
    action(ui,'Смена пароля','password',service,payload={'password':first})
    if service in ('wifi','all'): wait_ap(ui)


def radio_menu(ui):
    wifi=load('e-dev-wifi')
    while True:
        data=wifi.radio_current()
        choice=ui.menu('AP · Wi-Fi',data['ssid']+' · '+('2.4 GHz' if data['band']=='bg' else '5 GHz')+' · канал '+(str(data['channel']) if data['channel'] else 'AUTO')+'\nЗащита WPA2 / AES-CCMP',
                       [('ssid','Название сети'),('radio','Диапазон и канал'),('password','Пароль Wi-Fi')])
        if choice is None: return
        if choice=='password': password(ui,'wifi');continue
        if choice=='ssid':
            value=ui.input('Название AP','SSID: 1–32 байта.',data['ssid'])
            if value is None: continue
            data['ssid']=value
        elif choice=='radio':
            band=ui.menu('Диапазон AP','Выберите диапазон.',[('bg','2.4 GHz'),('a','5 GHz')])
            if band is None: continue
            channels=[0,1,6,11] if band=='bg' else [0,36,40,44,48,149,153,157,161]
            channel=ui.menu('Канал AP','Доступность зависит от адаптера и страны Wi-Fi.',
                            [(str(c),'AUTO' if c==0 else str(c)) for c in channels]+[('custom','Ввести другой канал')])
            if channel is None: continue
            if channel=='custom': channel=ui.input('Канал AP','Номер канала; 0 — автоматически.',str(data['channel']))
            if channel is None: continue
            data.update(band=band,channel=int(channel))
        data=wifi.validate_radio(data)
        if not ui.yes('Применить AP?',data['ssid']+' · '+data['band']+' · канал '+str(data['channel'])+'\nWi-Fi переподключится. При ошибке служба выполнит откат.'):
            continue
        action(ui,'Настройки AP','radio',payload=data)
        wait_ap(ui)


def direct_rules(ui,kind):
    hybrid=load('e-dev-hybrid')
    title='Прямые домены' if kind=='domains' else 'Прямые IP / сети'
    filename='direct-domains' if kind=='domains' else 'direct-ips'
    while True:
        values=hybrid.words(filename)
        choice=ui.menu(title,'Эти назначения идут напрямую в режиме HYBRID.',
                       [('add','Добавить правило')]+[('rule:'+value,value) for value in values])
        if choice is None: return
        if choice=='add':
            value=ui.input(title,'Домен без https:// и пути:' if kind=='domains' else 'Публичный IPv4 или сеть CIDR:')
            if value: action(ui,title,'hybrid',kind,'add',value)
        else:
            value=choice.removeprefix('rule:')
            if ui.yes('Удалить правило?',value): action(ui,title,'hybrid',kind,'del',value)


def hybrid_menu(ui):
    while True:
        data=cfg('hybrid.json',dict(geo=True,autoupdate=True,dns=['1.1.1.1','8.8.8.8']))
        geo=cfg('geo-info.json')
        updated=geo.get('updated','нет')
        if updated!='нет':
            try: updated=datetime.datetime.fromisoformat(updated).astimezone().strftime('%d.%m.%Y %H:%M')
            except ValueError: pass
        choice=ui.menu('AP · Hybrid Settings','RU-база: '+str(geo.get('networks',0))+' сетей\nОбновление: '+str(updated),
                       [('geo','Учёт RU IP-базы · '+('ВКЛ' if data['geo'] else 'ВЫКЛ')),
                        ('autoupdate','Ежедневное обновление · '+('ВКЛ' if data['autoupdate'] else 'ВЫКЛ')),
                        ('update','Обновить IP-базу сейчас'),('domains','Прямые домены'),
                        ('ips','Прямые IP / сети'),('check','Проверить маршрут домена / IP')])
        if choice is None: return
        if choice in ('geo','autoupdate'):
            action(ui,'Hybrid Settings','hybrid',choice,'off' if data[choice] else 'on')
        elif choice=='update': action(ui,'RU IP-база','hybrid','geo','update')
        elif choice in ('domains','ips'): direct_rules(ui,choice)
        elif choice=='check':
            value=ui.input('Проверка маршрута','Домен или IPv4:')
            if value: action(ui,'Маршрут','check',value)


