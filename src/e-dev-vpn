#!/usr/bin/env python3
"""E-DEV routing and tunnel lifecycle: independent controls, fail closed."""
import pathlib as P, subprocess as S, sys, re, fcntl, ipaddress, json, os, time
B=P.Path('/etc/e-dev')
DNS_ROTATION_SECONDS=3600
DNS_SETS=('ru4','vpn4')
def call(*a,check=True,input=None):
 env=dict(os.environ,WG_QUICK_USERSPACE_IMPLEMENTATION='/usr/local/sbin/e-dev-awg-launch') if a[0]=='awg-quick' else None
 return S.run(a,input=input,text=True,stdout=S.PIPE,stderr=S.PIPE,check=check,env=env)
def save(name,value):
 p=B/(name+'.new');p.write_text(value+'\n');p.chmod(0o644);p.replace(B/name)
def enabled(): return not (B/'vpn-enabled').exists() or (B/'vpn-enabled').read_text().strip()=='on'
def readmode():
 mode=(B/'mode').read_text().strip()
 return mode if mode in ('vpn','direct','hybrid') else 'vpn'
def ap_interface():
 p=B/'wifi.json';cfg=json.loads(p.read_text()) if p.exists() else {}
 return ipaddress.IPv4Interface(cfg.get('address','10.42.0.1/24'))
def out_device():
 p=B/'wifi.json';cfg=json.loads(p.read_text()) if p.exists() else {}
 return 'edevbr0' if cfg.get('interface')=='edevbr0' else 'wlan0'
def local_routes():
 # AP comes from settings; the physical LAN comes from current kernel routes.
 routes=[(str(ap_interface().network),out_device()),('10.43.0.0/24','vpnbr0'),('10.158.92.0/24','incusbr0')]
 try:
  result=call('ip','-j','-4','route','show','table','main',check=False)
  for row in json.loads(result.stdout or '[]'):
   dev=row.get('dev','');dst=row.get('dst','default')
   if row.get('scope')!='link' or str(row.get('protocol')) not in ('kernel','241') or dst=='default': continue
   if dev not in (out_device(),'vpnbr0','incusbr0') and not dev.startswith(('eth','wl','en')): continue
   net=str(ipaddress.IPv4Network(dst,strict=False))
   if (net,dev) not in routes: routes.append((net,dev))
 except (ValueError,OSError): pass
 return routes

def rules(mode):
 ap=ap_interface();subnet=str(ap.network)
 nets='{ 10.43.0.0/24, '+subnet+' }' if mode!='direct' else '10.43.0.0/24'
 # Local devices stay reachable even while the tunnel starts or fails. The
 # fail-closed guard protects Internet traffic, not the directly attached LAN.
 allowed='ip daddr { '+', '.join(sorted(set(net for net,dev in local_routes())))+' } accept'
 if mode!='blocked': allowed+='\n  oifname "awg0" accept'
 if mode=='hybrid': allowed='ip saddr '+subnet+' meta mark 0x42 accept\n  '+allowed
 dns=str(ap.ip)+':1053' if mode!='blocked' else '1.1.1.1'
 return '''table inet e_dev_guard {
 chain forward { type filter hook forward priority -10; policy accept;
  iifname "OUTDEV" ip saddr != APNET counter drop
  iifname "vpnbr0" ip saddr != 10.43.0.0/24 counter drop
  ip saddr NETS jump protect
  iifname { "OUTDEV", "vpnbr0" } meta nfproto ipv6 drop
 }
 chain protect { ALLOWED
  counter drop
 }
 chain dns { type nat hook prerouting priority dstnat - 10; policy accept;
  ip saddr NETS udp dport 53 dnat ip to DNSDEST
  ip saddr NETS tcp dport 53 dnat ip to DNSDEST
 }
 chain mss { type filter hook forward priority mangle; policy accept;
  oifname "awg0" tcp flags & (syn | rst) == syn tcp option maxseg size > 1360 tcp option maxseg size set 1360 counter
  iifname "awg0" tcp flags & (syn | rst) == syn tcp option maxseg size > 1360 tcp option maxseg size set 1360 counter
 }
 chain nat { type nat hook postrouting priority srcnat + 10; policy accept;
  ip saddr { APNET, 10.43.0.0/24 } oifname "awg0" masquerade
 }
}'''.replace('DNSDEST',dns).replace('NETS',nets).replace('ALLOWED',allowed).replace('APNET',subnet).replace('OUTDEV',out_device())+'\n'
def geo_load():
 p=B/'ru4.zone'
 if not p.exists(): return
 nets=[str(ipaddress.IPv4Network(x)) for x in p.read_text().split()]
 if not nets: raise ValueError('Empty IP list')
 call('nft','-f','-',input='flush set inet e_dev_split rusubnets\nadd element inet e_dev_split rusubnets { '+', '.join(nets)+' }\n')
def hybrid_cfg():
 p=B/'hybrid.json'
 return json.loads(p.read_text()) if p.exists() else {'geo':True,'autoupdate':True,'dns':['1.1.1.1','8.8.8.8']}
def custom_load():
 p=B/'direct-ips'
 nets=[str(ipaddress.IPv4Network(x)) for x in p.read_text().split()] if p.exists() else []
 batch='flush set inet e_dev_split custom4\n'
 if nets: batch+='add element inet e_dev_split custom4 { '+', '.join(nets)+' }\n'
 call('nft','-f','-',input=batch)

def dns_set(name):
 result=call('nft','-j','list','set','inet','e_dev_split',name,check=False)
 if result.returncode:return None
 return next(row['set'] for row in json.loads(result.stdout)['nftables'] if 'set' in row)

def dns_set_values(data):
 values=[]
 for item in data.get('elem',[]):
  value=item['elem']['val'] if isinstance(item,dict) else item
  values.append(str(ipaddress.IPv4Address(value)))
 return sorted(set(values))

def dns_elements(name,values):
 return 'add element inet e_dev_split '+name+' { '+', '.join(values)+' }\n' if values else ''

def dns_rotation_state(now=None,boot=None):
 now=time.monotonic() if now is None else now
 boot=P.Path('/proc/sys/kernel/random/boot_id').read_text().strip() if boot is None else boot
 try:
  state=json.loads((B/'dns-rotation.json').read_text())
  if state['boot']==boot and 0<=state['time']<=now:return state
 except (OSError,ValueError,KeyError,TypeError):pass
 state=dict(boot=boot,time=now);save('dns-rotation.json',json.dumps(state));return state

def rotate_dns_sets(now=None,boot=None):
 now=time.monotonic() if now is None else now
 state=dns_rotation_state(now,boot)
 if now-state['time']<DNS_ROTATION_SECONDS:return False
 # Keep the preceding generation longer than the entire DNS cache/client
 # lifetime. dnsmasq does not refresh an existing nft element's timeout.
 # The transaction retains all current addresses without a routing gap.
 batch='';counts={}
 for name in DNS_SETS:
  data=dns_set(name)
  if data is None or dns_set(name+'_prev') is None:raise ValueError('DNS routing sets are not initialized.')
  values=dns_set_values(data);counts[name]=len(values)
  batch+='flush set inet e_dev_split '+name+'_prev\n'+dns_elements(name+'_prev',values)
  # Delete only the snapshot members: DNS can add a new address between our
  # read and the transaction. Flushing the current set would lose that reply.
  if values:batch+='delete element inet e_dev_split '+name+' { '+', '.join(values)+' }\n'
 # Save first: if storage or the kernel transaction fails, retaining an old
 # generation longer is safer than retrying a successful rotation too early.
 state['time']=now;save('dns-rotation.json',json.dumps(state))
 call('nft','-f','-',input=batch)
 print('DNS routing generation rotated: '+json.dumps(counts));return True

def split(mode):
 exists=call('nft','list','table','inet','e_dev_split',check=False).returncode==0
 if not exists:
  call('nft','-f','-',input='add table inet e_dev_split\nadd chain inet e_dev_split classify { type filter hook prerouting priority mangle; policy accept; }\n')
 if call('nft','list','set','inet','e_dev_split','rusubnets',check=False).returncode:
  call('nft','-f','-',input='add set inet e_dev_split rusubnets { type ipv4_addr; flags interval; auto-merge; }\n')
  geo_load()
 if call('nft','list','set','inet','e_dev_split','custom4',check=False).returncode:
  call('nft','-f','-',input='add set inet e_dev_split custom4 { type ipv4_addr; flags interval; auto-merge; }\n')
 custom_load()
 batch='flush chain inet e_dev_split classify\n'
 for name in DNS_SETS:
  data=dns_set(name)
  if data and 'timeout' in data.get('flags',[]):
   batch+='delete set inet e_dev_split '+name+'\n'
  if data is None or 'timeout' in data.get('flags',[]):
   batch+='add set inet e_dev_split '+name+' { type ipv4_addr; }\n'
   if data:batch+=dns_elements(name,dns_set_values(data))
  if dns_set(name+'_prev') is None:batch+='add set inet e_dev_split '+name+'_prev { type ipv4_addr; }\n'
 if mode=='hybrid':
  prefix='add rule inet e_dev_split classify ip saddr '+str(ap_interface().network)
  local='{ '+', '.join(sorted(set(net for net,dev in local_routes())))+' }'
  batch+=prefix+' ip daddr '+local+' meta mark set 0 ct mark set 0 return\n'
  # Keep established sessions on their original exit across DNS generations.
  batch+=prefix+' ct state established,related ct mark 0x42 meta mark set 0x42 return\n'
  batch+=prefix+' ct state established,related ct mark 0x43 meta mark set 0 return\n'
  # Explicit direct rules win over VPN-domain exceptions; VPN-domain exceptions
  # win over GeoIP. A foreign service may use a server with a Russian IP.
  for name in ('custom4','ru4','ru4_prev'):
   batch+=prefix+' ip daddr @'+name+' meta mark set 0x42 ct mark set 0x42 counter return\n'
  for name in ('vpn4','vpn4_prev'):
   batch+=prefix+' ip daddr @'+name+' meta mark set 0 ct mark set 0x43 counter return\n'
  if hybrid_cfg()['geo']:
   batch+=prefix+' ip daddr @rusubnets meta mark set 0x42 ct mark set 0x42 counter return\n'
  batch+=prefix+' meta mark set 0 ct mark set 0x43\n'
 call('nft','-f','-',input=batch)
def guard(mode):
 split(mode)
 data=rules(mode)
 exists=call('nft','list','table','inet','e_dev_guard',check=False).returncode==0
 call('nft','-f','-',input=('delete table inet e_dev_guard\n' if exists else '')+data)
 p=B/'ap-guard.nft.new';p.write_text(data);p.replace(B/'ap-guard.nft')
def routes(mode):
 call('sysctl','-w','net.ipv4.conf.all.src_valid_mark=1')
 for priority in ('10419','10422'):
  while call('ip','rule','del','priority',priority,check=False).returncode==0: pass
 call('ip','rule','add','priority','10422','oif','awg0','lookup','1042')
 if mode=='hybrid': call('ip','rule','add','priority','10419','from',str(ap_interface().network),'fwmark','0x42','lookup','main')
 call('ip','route','replace','blackhole','default','metric','32760','table','1042')
 # Preserve unchanged local routes during VPN changes too.
 wanted=set(local_routes())
 try:
  previous=json.loads(call('ip','-j','-4','route','show','table','1042',check=False).stdout or '[]')
  existing={(row['dst'],row.get('dev','')) for row in previous if row.get('dst') not in (None,'default')}
 except ValueError: existing=set()
 for net,dev in sorted(wanted-existing):
  call('ip','route','replace',net,'dev',dev,'table','1042',check=False)
 for net,dev in sorted(existing-wanted):
  if not any(net==dst for dst,_ in wanted):call('ip','route','del',net,'table','1042',check=False)
 for priority,net in [('10420',str(ap_interface().network)),('10421','10.43.0.0/24')]:
  while call('ip','rule','del','priority',priority,check=False).returncode==0: pass
  if net=='10.43.0.0/24' or mode!='direct': call('ip','rule','add','priority',priority,'from',net,'lookup','1042')
def down():
 call('awg-quick','down','awg0',check=False)
 call('systemctl','stop','e-dev-awg-go@awg0.service',check=False)
 call('ip','route','del','default','dev','awg0','table','1042',check=False)
def tunnel(name):
 if not re.fullmatch('[a-zA-Z0-9][a-zA-Z0-9_-]{0,31}',name): raise ValueError('Invalid profile')
 source=B/'profiles'/(name+'.conf');data=[]
 for line in source.read_text().splitlines():
  key=line.split('=',1)[0].strip().lower()
  if key in ('dns','table','preup','postup','predown','postdown','saveconfig'): continue
  if key=='allowedips': line='AllowedIPs = 0.0.0.0/0'
  data.append(line)
  if line.strip()=='[Interface]': data.append('Table = off')
 down()
 p=P.Path('/etc/amnezia/amneziawg/awg0.conf');p.write_text('\n'.join(data)+'\n');p.chmod(0o600)
 call('awg-quick','up','awg0')
 call('sysctl','-w','net.ipv4.conf.all.rp_filter=2','net.ipv4.conf.awg0.rp_filter=2')
 call('ip','route','replace','default','dev','awg0','metric','10','table','1042')
def main():
 with open('/run/e-dev-vpn.lock','w') as lock:
  fcntl.flock(lock,fcntl.LOCK_EX)
  command=sys.argv[1] if len(sys.argv)>1 else 'boot'
  if command=='refresh' and not (B/'mode').exists():return
  mode=readmode();name=(B/'selected-profile').read_text().strip()
  if command=='dns-rotate':rotate_dns_sets();return
  try:dns_rotation_state()
  except OSError:print('DNS generation clock could not be saved; VPN recovery continues.',file=sys.stderr)
  if command in ('on','off','hybrid'):
   mode={'on':'vpn','off':'direct','hybrid':'hybrid'}[command]
   guard('blocked' if mode!='direct' else 'direct');routes(mode);guard(mode);save('mode',mode)
  elif command in ('stop','shutdown'):
   if command=='stop': save('vpn-enabled','off')
   guard('blocked' if mode!='direct' else 'direct');down();routes(mode);guard(mode)
  elif command in ('start','boot','use'):
   if command=='start': save('vpn-enabled','on')
   if command in ('start','boot') and (B/'vpn-policy.json').exists():
    policy=json.loads((B/'vpn-policy.json').read_text())
    primary=policy.get('primary')
    if policy.get('mode')=='default' and primary and (B/'profiles'/(primary+'.conf')).is_file(): name=primary
   if command=='use':
    name=sys.argv[2]
    if not re.fullmatch('[a-zA-Z0-9][a-zA-Z0-9_-]{0,31}',name) or not (B/'profiles'/(name+'.conf')).is_file(): raise ValueError('Unknown profile')
   guard('blocked' if mode!='direct' else 'direct');routes(mode)
   if enabled(): tunnel(name)
   else: down()
   guard(mode);save('selected-profile',name)
   call('systemctl','--no-block','try-restart','e-dev-dns.service',check=False)
   if command in ('start','boot') and (B/'vpn-policy.json').exists() and json.loads((B/'vpn-policy.json').read_text()).get('mode')=='auto' and enabled():
    call('systemctl','--no-block','start','e-dev-auto.service',check=False)
  elif command=='refresh': routes(mode);guard(mode)
  elif command=='geo-load': split(mode);geo_load()
  else: raise ValueError('Unknown operation')
  print('AP: '+mode+'; VPN: '+('on' if enabled() else 'off')+'; профиль: '+name)
if __name__=='__main__':
 try: main()
 except Exception as e:
  print('Операция не завершена. VPN-трафик остаётся закрытым при отсутствии туннеля. Проверьте journalctl -u e-dev-vpn.',file=sys.stderr)
  sys.exit(1)
